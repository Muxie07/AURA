# =============================================================================
# AURA — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# =============================================================================
# Application
# =============================================================================
AURA_ENV=development
# Options: development | staging | production
AURA_DEBUG=true
AURA_SECRET_KEY=change-this-to-a-cryptographically-secure-random-string-in-production
AURA_CORS_ORIGINS='["http://localhost:3000","http://localhost:3001"]'

# =============================================================================
# API Server
# =============================================================================
AURA_API_HOST=0.0.0.0
AURA_API_PORT=8000
AURA_API_WORKERS=1
# In production, set this to your actual domain
AURA_API_BASE_URL=http://localhost:8000

# =============================================================================
# Database — PostgreSQL
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aura
POSTGRES_USER=aura
POSTGRES_PASSWORD=change-this-password-in-production

# Assembled by the application — do not set manually unless overriding
# DATABASE_URL=postgresql+asyncpg://aura:password@localhost:5432/aura

# Database connection pool settings
AURA_DB_POOL_SIZE=10
AURA_DB_MAX_OVERFLOW=20
AURA_DB_POOL_TIMEOUT=30

# =============================================================================
# Redis (optional in Phase 1, required in later phases)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# AI Provider — LLM
# =============================================================================
# Provider: openai | anthropic | google | azure_openai | ollama
MODEL_PROVIDER=openai

# Model identifier (provider-specific)
MODEL_NAME=gpt-4o

# Temperature for generation (0.0 = deterministic, 1.0 = creative)
MODEL_TEMPERATURE=0.1

# Maximum tokens to generate
MODEL_MAX_TOKENS=4096

# Generation timeouts and retries
LLM_TIMEOUT=60
LLM_RETRY_MAX=3
LLM_RETRY_DELAY=2.0

# =============================================================================
# AI Provider — Embeddings
# =============================================================================
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# =============================================================================
# API Keys (never commit these)
# =============================================================================
OPENAI_API_KEY="your_openai_api_key_here"
ANTHROPIC_API_KEY="your_anthropic_api_key_here"
GOOGLE_AI_API_KEY="your_google_api_key_here"

# =============================================================================
# Security
# =============================================================================
# JWT settings
AURA_JWT_ALGORITHM=HS256
AURA_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
AURA_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# API key header for service-to-service auth
AURA_INTERNAL_API_KEY=change-this-to-a-strong-random-key

# =============================================================================
# Observability
# =============================================================================
AURA_LOG_LEVEL=INFO
# Format: json | text (use json in production)
AURA_LOG_FORMAT=json

# Optional: OpenTelemetry
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=aura-backend

# =============================================================================
# Rate Limiting
# =============================================================================
AURA_RATE_LIMIT_REQUESTS=100
AURA_RATE_LIMIT_WINDOW_SECONDS=60

# =============================================================================
# Agent Configuration
# =============================================================================
AURA_AGENT_MAX_ITERATIONS=10
AURA_AGENT_TIMEOUT_SECONDS=120
AURA_AGENT_ENABLE_HUMAN_APPROVAL=true

# =============================================================================
# RAG Configuration
# =============================================================================
AURA_RAG_CHUNK_SIZE=512
AURA_RAG_CHUNK_OVERLAP=64
AURA_RAG_TOP_K=5
AURA_RAG_SIMILARITY_THRESHOLD=0.7
