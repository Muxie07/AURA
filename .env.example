# ==============================================================================
# AURA Environment Configuration
# Copy this file to .env and replace placeholder values.
# DO NOT commit real secrets to source control.
# ==============================================================================

# Application Environment (development, testing, staging, production)
AURA_ENV=development
# Enable debug mode (verbose logs, stack traces in API errors)
AURA_DEBUG=true

# Security Keys
# AURA_SECRET_KEY / AURA_ENCRYPTION_KEY must be a cryptographically secure random string (at least 32 chars)
# e.g., openssl rand -hex 32
AURA_SECRET_KEY="super-secret-key-change-in-production-at-least-32-chars"
AURA_ENCRYPTION_KEY=

# Database Configuration (PostgreSQL)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=aura
POSTGRES_PASSWORD=aura_password
POSTGRES_DB=aura
# Connection pool settings
AURA_DB_POOL_SIZE=10
AURA_DB_MAX_OVERFLOW=20
AURA_DB_POOL_TIMEOUT=30

# Redis Configuration (Caching, Rate Limiting, ARQ)
REDIS_URL=redis://redis:6379/0

# Rate Limiting
AURA_RATE_LIMIT_REQUESTS=100
AURA_RATE_LIMIT_WINDOW_SECONDS=60

# Logging Configuration
# Format: json or text
AURA_LOG_FORMAT=text
# Level: DEBUG, INFO, WARNING, ERROR
AURA_LOG_LEVEL=INFO

# Sentry DSN (Optional, for error tracking in production)
SENTRY_DSN=

# LLM Providers
# The primary provider used by the application (google, openai, anthropic, mock)
LLM_PROVIDER=mock
# Gemini
GEMINI_API_KEY=
# OpenAI
OPENAI_API_KEY=
# Anthropic
ANTHROPIC_API_KEY=

# Seed Script Demo Password (Argon2 / Bcrypt)
AURA_DEMO_PASSWORD=demo1234

# ==============================================================================
# Google OAuth 2.0 & Gmail Integration
# Minimum required scope: https://www.googleapis.com/auth/gmail.send
# ==============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/gmail/oauth/callback
GOOGLE_GMAIL_SCOPE=https://www.googleapis.com/auth/gmail.send
GMAIL_SENDER_EMAIL=
AURA_FRONTEND_BASE_URL=http://localhost:3000

# ==============================================================================
# Approval emails (approve / decline from your phone)
# ==============================================================================
# Resend sends over HTTPS, so it works on hosts that block SMTP ports.
# Free tier: sign up with the address that should receive approvals; until a
# domain is verified, Resend only delivers to that account's own email.
RESEND_API_KEY=
RESEND_FROM=AURA Approvals <onboarding@resend.dev>
# Who gets the approval email when a run doesn't name a recipient
AURA_APPROVAL_EMAIL=
# Public URLs: the approve/decline links in the email are built from these.
# They must be the deployed backend/frontend, not localhost.
AURA_API_BASE_URL=http://localhost:8000
AURA_FRONTEND_BASE_URL=http://localhost:3000
